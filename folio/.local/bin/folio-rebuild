#!/usr/bin/env bash
# Rebuild ~/.local/bin/folio from the installed Folio version, patched so
# folio.conf also controls: showHidden, startAt, font/fontSize, sidebarWidth
# and sidebarCompact. Run again after `omarchy update` upgrades Folio.
set -euo pipefail

ver=$(pacman -Q folio | awk '{print $2}' | sed 's/-.*$//')
marker="$HOME/.local/state/folio-patched-version"

if [[ "${1:-}" != "--force" && -x "$HOME/.local/bin/folio" && -f "$marker" && "$(cat "$marker")" == "$ver" ]]; then
    echo "Folio $ver is already patched; nothing to do."
    exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if ! git clone -q --depth 1 --branch "v$ver" https://github.com/omacom/folio.git "$work/src" 2>/dev/null; then
    echo "Tag v$ver not found; building from main instead."
    git clone -q --depth 1 https://github.com/omacom/folio.git "$work/src"
fi

python3 - "$work/src" <<'PY'
import sys, pathlib
root = pathlib.Path(sys.argv[1])

def patch(rel, old, new):
    p = root / rel
    s = p.read_text()
    if s.count(old) != 1:
        raise SystemExit(f"patch pattern not found exactly once in {rel}")
    p.write_text(s.replace(old, new, 1))

patch("src/foldermodel.cpp",
      "#include <QStandardPaths>\n#include <QFile>",
      "#include <QStandardPaths>\n#include <QSettings>\n#include <QFile>")
patch("src/foldermodel.cpp",
      "FolderModel::FolderModel(QObject *parent) : QAbstractListModel(parent) {\n",
      "FolderModel::FolderModel(QObject *parent) : QAbstractListModel(parent) {\n"
      "    QSettings settings;\n"
      "    m_showHidden = settings.value(QStringLiteral(\"showHidden\"), false).toBool();\n")
patch("src/foldermodel.cpp",
      "    m_showHidden = show;\n    emit showHiddenChanged();",
      "    m_showHidden = show;\n"
      "    QSettings settings;\n"
      "    settings.setValue(QStringLiteral(\"showHidden\"), show);\n"
      "    settings.sync();\n"
      "    emit showHiddenChanged();")

patch("src/main.cpp",
      "#include <QGuiApplication>\n#include <QIcon>",
      "#include <QGuiApplication>\n#include <QIcon>\n#include <QSettings>")
patch("src/main.cpp",
      "static QString startPath(const QStringList &args, QString *select) {\n"
      "    if (args.size() < 2)\n"
      "        return QDir::homePath();\n",
      "static QString startPath(const QStringList &args, QString *select) {\n"
      "    if (args.size() < 2) {\n"
      "        QSettings settings;\n"
      "        const QString configured = settings.value(QStringLiteral(\"startAt\"), QString()).toString();\n"
      "        if (!configured.isEmpty() && QFileInfo(configured).isDir())\n"
      "            return QFileInfo(configured).absoluteFilePath();\n"
      "        return QDir::homePath();\n"
      "    }\n")

patch("src/theme.cpp",
      "#include <QRegularExpression>\n#include <QStandardPaths>",
      "#include <QRegularExpression>\n#include <QSettings>\n#include <QStandardPaths>")
patch("src/theme.cpp",
      """    const QFont fixed = QFontDatabase::systemFont(QFontDatabase::FixedFont);
    // A size-only update keeps the family last resolved: the configuration
    // Qt started with may predate a fonts.conf change resolved since.
    QString family = !reloadConfig && fixed.family() == m_requestedFamily ? m_resolvedFamily : QString();
    if (family.isEmpty() && !reloadConfig) {
        if (FcConfig *current = FcConfigGetCurrent())
            family = matchFamily(current, fixed.family());
    }
    if (family.isEmpty())
        family = resolveFamily(fixed.family());
    m_requestedFamily = fixed.family();
    m_resolvedFamily = family;
    const qreal scale = effectiveTextScale(fixed.pointSizeF());
""",
      """    const QFont fixed = QFontDatabase::systemFont(QFontDatabase::FixedFont);
    QSettings settings;
    const QString configuredFamily = settings.value(QStringLiteral("font"), QString()).toString();
    const int configuredSize = settings.value(QStringLiteral("fontSize"), 0).toInt();
    QString family = configuredFamily;
    if (family.isEmpty()) {
        family = !reloadConfig && fixed.family() == m_requestedFamily ? m_resolvedFamily : QString();
        if (family.isEmpty() && !reloadConfig) {
            if (FcConfig *current = FcConfigGetCurrent())
                family = matchFamily(current, fixed.family());
        }
        if (family.isEmpty())
            family = resolveFamily(fixed.family());
    }
    m_requestedFamily = fixed.family();
    m_resolvedFamily = family;
    qreal scale = effectiveTextScale(fixed.pointSizeF());
    if (configuredSize > 0)
        scale = std::clamp(qreal(configuredSize) / designPoints, 0.75, 1.5);
""")

patch("src/Main.qml",
      '    property string viewMode: "columns"\n    property real zoom: 1\n',
      '    property string viewMode: "columns"\n'
      '    property real zoom: 1\n'
      '    property int sidebarWidth: 190\n'
      '    property bool sidebarCompact: false\n')
patch("src/Main.qml",
      "    Settings {\n        property alias viewMode: win.viewMode\n        property alias zoom: win.zoom\n    }",
      "    Settings {\n"
      "        property alias viewMode: win.viewMode\n"
      "        property alias zoom: win.zoom\n"
      "        property alias sidebarWidth: win.sidebarWidth\n"
      "        property alias sidebarCompact: win.sidebarCompact\n"
      "    }")
patch("src/Main.qml",
      "            Sidebar {\n                id: sidebar\n                target:",
      "            Sidebar {\n                id: sidebar\n                compact: win.sidebarCompact\n                target:")
patch("src/Main.qml",
      "                Layout.preferredWidth: Math.round(190 * theme.textScale)",
      "                Layout.preferredWidth: Math.round(win.sidebarWidth * theme.textScale)")

patch("src/Sidebar.qml",
      "    property int cursor: 0\n    // The pane the sidebar acts on: the one used last.",
      "    property int cursor: 0\n"
      "    property bool compact: false\n"
      "    // The pane the sidebar acts on: the one used last.")
patch("src/Sidebar.qml",
      "        Layout.topMargin: 21\n        Layout.leftMargin: 14\n        Layout.bottomMargin: 6",
      "        Layout.topMargin: compact ? 12 : 21\n"
      "        Layout.leftMargin: compact ? 10 : 14\n"
      "        Layout.bottomMargin: compact ? 3 : 6")
patch("src/Sidebar.qml",
      """        implicitHeight: detail.length > 0 ? Math.max(44, Math.round(40 * theme.textScale))
                                          : Math.max(34, Math.round(28 * theme.textScale))
        leftPadding: mirrored ? endPadding : 14
        rightPadding: mirrored ? 14 : endPadding
""",
      """        implicitHeight: detail.length > 0 ? Math.max(compact ? 42 : 44, Math.round((compact ? 38 : 40) * theme.textScale))
                                          : Math.max(compact ? 30 : 34, Math.round((compact ? 25 : 28) * theme.textScale))
        leftPadding: mirrored ? endPadding : (compact ? 10 : 14)
        rightPadding: mirrored ? (compact ? 10 : 14) : endPadding
""")

# Split-window button in the top-right bar, between help and the view buttons.
patch("src/Glyph.qml",
      '        case "columns": return box(3, 4, 18, 16, r) + "M9 4v16M15 4v16"\n',
      '        case "columns": return box(3, 4, 18, 16, r) + "M9 4v16M15 4v16"\n'
      '        case "split": return box(3, 4, 8, 16, r / 2) + box(13, 4, 8, 16, r / 2)\n')
patch("src/PathBar.qml",
      "    // The right pane of a split has a close button (Ctrl+W).\n"
      "    property bool closable: false\n"
      "    signal closeRequested()\n",
      "    // The right pane of a split has a close button (Ctrl+W).\n"
      "    property bool closable: false\n"
      "    property bool split: false\n"
      "    signal closeRequested()\n"
      "    signal splitRequested()\n")
patch("src/PathBar.qml",
      "        // Shows the current view; clicking moves to the next one.\n"
      "        IconButton {\n"
      "            glyph: bar.viewMode\n",
      "        IconButton {\n"
      "            visible: !chooser && !bar.closable\n"
      "            glyph: \"split\"\n"
      "            active: bar.split\n"
      "            text: bar.split ? qsTr(\"Close split\") : qsTr(\"Split window\")\n"
      "            onClicked: bar.splitRequested()\n"
      "        }\n"
      "        // Shows the current view; clicking moves to the next one.\n"
      "        IconButton {\n"
      "            glyph: bar.viewMode\n")
patch("src/FolderPane.qml",
      "        viewMode: pane.viewMode\n"
      "        closable: pane.closable\n"
      "        onCycleView: pane.cycleView()\n",
      "        viewMode: pane.viewMode\n"
      "        closable: pane.closable\n"
      "        split: !!pane.host && pane.host.split\n"
      "        onCycleView: pane.cycleView()\n"
      "        onSplitRequested: {\n"
      "            if (!pane.host)\n"
      "                return\n"
      "            if (pane.host.split)\n"
      "                pane.host.closeSplit()\n"
      "            else\n"
      "                pane.host.openSplit()\n"
      "        }\n")
PY

cmake -S "$work/src" -B "$work/build" -G Ninja -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release >/dev/null
cmake --build "$work/build" -j"$(nproc)" >/dev/null
install -Dm755 "$work/build/folio" "$HOME/.local/bin/folio"
mkdir -p "$(dirname "$marker")"
printf '%s\n' "$ver" > "$marker"
echo "Patched Folio installed to ~/.local/bin/folio (source version: $ver)."
