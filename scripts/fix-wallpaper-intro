#!/bin/bash
# Recover the desktop if an Omarchy background intro wedges the wallpaper.
#
# Symptom this fixes: after an intro plays (or tries to), the wallpaper is
# blank/absent and wallpaper changes stop applying. Cause: owed's renderer
# handoff fails ("intro ended: renderer handoff failed" / "omarchy-shell is not
# responding"), and owed -- a systemd user service -- keeps respawning a
# fullscreen owe-render that sits over the desktop.
#
# Safe to run at any time. Needs no sudo. Intros are disabled afterwards so the
# loop cannot start again; re-enable with:  rm -f <toggle>

set -u

TOGGLE="$HOME/.local/state/omarchy/toggles/background-intros-off"

echo "==> disabling background intros (stops any respawn loop)"
mkdir -p "$(dirname "$TOGGLE")"
: > "$TOGGLE"

echo "==> clearing the session marker so a stale 'already played' flag cannot linger"
rm -f "$HOME/.local/state/omarchy/background-intro.session-id" 2>/dev/null || true

echo "==> stopping owed (kills any stuck owe-render with it)"
systemctl --user stop owed.service 2>/dev/null || true
pkill -f 'owe-render' 2>/dev/null || true
sleep 2

echo "==> restarting the shell so the background surface is rebuilt"
omarchy restart shell >/dev/null 2>&1 || true
sleep 6

echo "==> starting owed back"
systemctl --user start owed.service 2>/dev/null || true
sleep 4

echo
echo "=== state ==="
printf "  owed.service     : %s\n" "$(systemctl --user is-active owed.service 2>/dev/null)"
printf "  quickshell       : %s\n" "$(pgrep -c -x quickshell 2>/dev/null || echo 0)"
printf "  owe-render procs : %s\n" "$(pgrep -cf 'owe-render' 2>/dev/null || echo 0)"
printf "  intros           : OFF (touch file present)"
printf "  background       : %s\n" "$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)"
echo
echo "If the wallpaper is still blank, switch it once (the picker also refreshes):"
echo "  omarchy-theme-bg-set ~/.local/state/omarchy/current/theme/backgrounds/1.jpg"
echo
echo "To re-enable intros later:  rm -f $TOGGLE"