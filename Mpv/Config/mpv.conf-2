################
profile=fast

#### GRAPHICS ####
vo=gpu-next
gpu-api=opengl
gpu-context=wayland
hwdec=auto
hwdec-codecs=all
wayland-internal-vsync=no
#target-colorspace-hint=no
#target-contrast=inf
#x11-bypass-compositor=no
force-window=immediate
#vd-lavc-dir=no
deinterlace=no
drag-and-drop=replace

#### AUDIO ####
volume-max=200
audio-channels=8
audio-device=pipewire
#af=lavcac3enc=yes
audio-pitch-correction=yes
alang=eng,en,enUS,en-US

#### GENERAL ####
keep-open=yes
save-position-on-quit=yes
video-aspect-override=16:9
#autofit=70x70
#autofit-smaller=70x70
#autofit-larger=70x70
auto-window-resize=no
#geometry=70x70
loop-playlist=inf
loop-file=inf
deband=no

#### OSD ####
osd-font-size=15
osd-bar=no
osd-blur=0.2
border=no
osc=no

#### Subtitles ####
demuxer-mkv-subtitle-preroll=yes
slang=eng,en,english,eng-us,engUS,eng-US,en-us,enUS,en-US,english-us,english-US
blend-subtitles=yes
sub-auto=all
sub-margin-y=25
sub-scale=0.42
sub-font=slate
sub-fonts-dir="/home/linuxer/"
sub-font-size=45
sub-blur=0.2
sub-border-color=0.0/0.0/0.0/0.8
sub-border-size=3.2
sub-color=0.9/0.9/1.0
sub-shadow-color=0.0/0.0/0.0/0.25
sub-shadow-offset=0
embeddedfonts=yes
sub-ass-use-video-data=all
sub-file-paths-append=ass
sub-file-paths-append=srt
sub-file-paths-append=sub
sub-file-paths-append=subs
sub-file-paths-append=subtitles
sub-ass-force-margins=yes

#### yt-dlp ####
#ytdl-format="bestvideo[vcodec^=avc][height<=?720p]+bestaudio/best"
#ytdl-format="bestvideo[height<=720][vcodec~='(?i)avc|h264']+bestaudio/best"
ytdl-format="bv*[height<=720][vcodec^=avc1]+ba[acodec=opus]/bv*[height<=720][vcodec^=avc1]+ba/best"
ytdl-raw-options=yes-playlist=,write-sub=,embed-subs=,write-auto-sub=
ytdl-raw-options-append=cookies-from-browser=chromium
script-opts-add=ytdl_hook-ytdl_path=yt-dlp
