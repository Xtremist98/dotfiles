#!/usr/bin/env bash
# kvswitch - switch the USER Qt/Kvantum + GTK theme between rose-pine-dark and solitude.
# User-side only (no sudo). For root apps (gparted/btrfs) also run: sudo bash ~/kvswitch-root <theme>
set -euo pipefail

THEME="${1:-}"
case "$THEME" in
  rose-pine-dark|rose-pine|rp)
    KV="rose-pine-dark"
    QT_SCHEME="$HOME/.config/qt6ct/colors/rosepine-dark.conf"
    # Minimal :root safety net. The flat #191724 look ALSO lives in the theme
    # itself (rose-pine-dark/gtk-4.0/libadwaita.css + gtk-3.0/gtk.css). This only
    # guarantees it if libadwaita ignores the theme css and falls back to built-in
    # Adwaita (user sheet > theme > builtin). No !important / * hacks.
    GTK4_NET=':root {
  --window-bg-color: #191724;
  --view-bg-color: #191724;
  --headerbar-bg-color: #191724;
  --sidebar-bg-color: #191724;
  --secondary-sidebar-bg-color: #191724;
  --dialog-bg-color: #191724;
  --popover-bg-color: #191724;
  --sidebar-backdrop-color: #191724;
  --secondary-sidebar-backdrop-color: #191724;
  --headerbar-backdrop-color: #191724;
}'
    ;;
  solitude|sol)
    KV="solitude"
    QT_SCHEME="$HOME/.config/qt6ct/colors/solitude.conf"
    GTK4_NET=""
    ;;
  *)
    echo "Usage: kvswitch {rose-pine-dark|solitude}" >&2
    exit 1
    ;;
esac

# Kvantum theme (widget styling)
sed -i "s/^theme=.*/theme=$KV/" "$HOME/.config/Kvantum/kvantum.kvconfig"

# qt6ct color scheme (palette layer)
sed -i "s|^color_scheme_path=.*|color_scheme_path=$QT_SCHEME|" "$HOME/.config/qt6ct/qt6ct.conf"

# GTK: gsettings + minimal user override
gsettings set org.gnome.desktop.interface gtk-theme "$KV" 2>/dev/null || true
gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
if [ -n "$GTK4_NET" ]; then
  printf '%s\n' "$GTK4_NET" > "$HOME/.config/gtk-4.0/gtk.css"
else
  rm -f "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
fi

echo "User session -> $KV (restart Qt/GTK apps / KvantumManager to apply)"
