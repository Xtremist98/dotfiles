#!/bin/sh
# pacclear - fully wipe the pacman cache, including stray subdirectories
# that `pacman -Scc` deliberately leaves behind.
# Runs every removal step as root (via sudo if needed) so it never silently
# fails on root-owned files, and never aborts early.

CACHE_DIR="${PACMAN_CACHE_DIR:-/var/cache/pacman/pkg}"

run() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	else
		sudo "$@"
	fi
}

# 1) Let pacman do its normal full clean (best-effort; may be blocked by
#    permissions or prompts). We don't abort if this fails.
run pacman -Scc --noconfirm || echo "pacclear: pacman -Scc skipped/failed (will hard-clean instead)"

# 2) Hard-remove every entry in the package cache as root. This empties the
#    cache regardless of pacman, including stray directories and junk files.
run rm -rf "$CACHE_DIR"/* 2>/dev/null || true
run find "$CACHE_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

# 3) Also wipe the sync database cache so `pacman -Syy` isn't needed later.
run rm -rf /var/cache/pacman/sync/* 2>/dev/null || true

echo "pacclear: done. $(run find "$CACHE_DIR" -mindepth 1 | wc -l) item(s) remaining in $CACHE_DIR"
