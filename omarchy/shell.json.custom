{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Indicators.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.clock",
          "birthYear": 1991,
          "format": "dddd hh:mm A",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "weather",
          "type": "qml"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Menu.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.workspaces",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Workspaces.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "id": "mpris",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "id": "window-info",
          "type": "qml"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Tray.qml",
          "type": "qml"
        },
        {
          "id": "sysinfo",
          "type": "qml"
        },
        {
          "id": "omarchy.model-usage"
        },
        {
          "id": "netspeed",
          "type": "qml"
        },
        {
          "id": "omarchy.network",
          "source": "~/.config/omarchy/plugins/local.bar/panels/network/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.bluetooth",
          "source": "~/.config/omarchy/plugins/local.bar/panels/bluetooth/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.audio",
          "source": "~/.config/omarchy/plugins/local.bar/panels/audio/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.monitor",
          "source": "~/.config/omarchy/plugins/local.bar/panels/monitor/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.power",
          "source": "~/.config/omarchy/plugins/local.bar/panels/power/Panel.qml",
          "type": "qml"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "box": {
      "borderColor": "#855e3f",
      "color": "#14ffffff",
      "groups": [
        [
          "omarchy.menu",
          "omarchy.workspaces"
        ],
        [
          "netspeed",
          "omarchy.network"
        ]
      ],
      "innerPadding": 4,
      "innerSpacing": 4,
      "moduleSpacing": 6,
      "outerMargin": 2,
      "radius": 8,
      "unboxed": [
        "omarchy.spacer"
      ]
    },
    "id": "local.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.oldjobobo.thpm"
    }
  ],
  "version": 1
}
