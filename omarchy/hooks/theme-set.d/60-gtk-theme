#!/usr/bin/env bash
# Sync GTK + Qt/Kvantum to the active Omarchy theme.
# Runs AFTER omarchy-theme-set-gnome (which forces Adawaita / Adwaita-dark based
# only on light/dark mode), so it overrides GTK to our custom libadwaita theme
# and keeps Qt/Kvantum (kvantum.kvconfig + qt6ct color scheme) in sync.
#
# Argument $1 is the theme name (passed by `omarchy hook theme-set`).
#
# Root Qt/GTK apps (gparted, btrfs-assistant) are NOT handled here because hooks
# run as the user, not root. After switching, run:
#   sudo bash ~/kvswitch-root <theme>

THEME="${1:-$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)}"

case "$THEME" in
  rose-pine-dark|solitude)
    # GTK override (omarchy-theme-set-gnome would otherwise force Adawaita)
    gsettings set org.gnome.desktop.interface gtk-theme "$THEME" 2>/dev/null
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null
    # Qt/Kvantum + user GTK sync
    if command -v kvswitch >/dev/null 2>&1; then
      kvswitch "$THEME"
    fi
    ;;
esac
