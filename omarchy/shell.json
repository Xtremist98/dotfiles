{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "exec": "echo '{\"text\":\"󰴑\",\"tooltip\":\"Extract text from screen\"}'",
          "id": "text-extraction",
          "interval": 3600,
          "onClick": "omarchy-capture-text",
          "type": "command"
        },
        {
          "birthYear": 1991,
          "format": "dddd hh:mm A",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.spacer",
          "size": 6
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "id": "mpris",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "id": "window-info",
          "type": "qml"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "sysinfo",
          "type": "qml"
        },
        {
          "id": "omarchy.model-usage"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "id": "netspeed",
          "type": "qml"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.oldjobobo.thpm"
    }
  ],
  "version": 1
}
