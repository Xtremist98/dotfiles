{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Indicators.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.clock",
          "birthYear": 1991,
          "format": "dddd hh:mm A",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm",
          "source": "~/.config/omarchy/plugins/local.clock/BarWidget.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.system-update",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/SystemUpdate.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.weather",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Weather.qml",
          "type": "qml"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Workspaces.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "id": "mpris",
          "source": "~/.config/omarchy/plugins/local.bar/panels/media/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "id": "window-info",
          "type": "qml",
          "source": "~/.config/omarchy/plugins/local.bar/panels/window/Panel.qml"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Tray.qml",
          "type": "qml",
          "settings": {
            "forceColorize": [
              "Free Download",
              "stremio-service"
            ]
          }
        },
        {
          "id": "omarchy.dropbox",
          "source": "~/.config/omarchy/plugins/local.dropbox/Panel.qml",
          "type": "qml"
        },
        {
          "id": "local.model-usage"
        },
        {
          "id": "sysinfo",
          "type": "qml"
        },
        {
          "id": "netspeed",
          "type": "qml"
        },
        {
          "id": "omarchy.network",
          "source": "~/.config/omarchy/plugins/local.bar/panels/network/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.bluetooth",
          "source": "~/.config/omarchy/plugins/local.bar/panels/bluetooth/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.audio",
          "source": "~/.config/omarchy/plugins/local.bar/panels/audio/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.monitor",
          "source": "~/.config/omarchy/plugins/local.bar/panels/monitor/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.power",
          "source": "~/.config/omarchy/plugins/local.bar/panels/power/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.system",
          "source": "~/.config/omarchy/plugins/local.bar/panels/system/Panel.qml",
          "type": "qml"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "box": {
      "borderColor": "#22ffffff",
      "color": "#14ffffff",
      "groups": [
        [
          "omarchy.menu",
          "omarchy.workspaces"
        ],
        [
          "netspeed",
          "omarchy.network"
        ],
        [
          "omarchy.bluetooth",
          "omarchy.audio",
          "omarchy.monitor",
          "omarchy.power"
        ],
        [
          "omarchy.tray",
          "omarchy.dropbox",
          "local.model-usage"
        ]
      ],
      "innerPadding": 4,
      "innerSpacing": 0,
      "moduleSpacing": 6,
      "outerMargin": 2,
      "radius": 8,
      "unboxed": [
        "omarchy.spacer"
      ]
    },
    "id": "local.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.oldjobobo.thpm"
    }
  ],
  "version": 1
}
