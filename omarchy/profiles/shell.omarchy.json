{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "plugins": [
    {
      "id": "io.github.oldjobobo.thpm"
    },
    {
      "id": "farangkao.emojis-nerd"
    },
    {
      "id": "mirador"
    },
    {
      "id": "io.github.smoothpixels.cursor-accent"
    }
  ],
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "id": "omarchy.bar",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "wian47.removable-drives"
        },
        {
          "id": "flux"
        },
        {
          "id": "io.github.birajdotdev.omacore"
        },
        {
          "id": "stappmus.activity-monitor"
        },
        {
          "id": "theme-picker"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [],
      "centerEnd": [
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.spacer"
        }
      ],
      "tray": []
    }
  }
}
