[Icon Theme]
Name=Folio
Comment=Flat folder cards in the style of Omarchy Folio, drawn from the current theme
Inherits=Papirus-espresso,Papirus,Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/mimetypes,scalable/actions

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/actions]
Size=24
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions
