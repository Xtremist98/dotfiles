#!/usr/bin/env python3
"""Draw Folio-style folders and line icons for the current Omarchy theme.

Folio (Omarchy's file manager) doesn't use an icon theme: it paints one folder
silhouette per tile and draws its toolbar icons as paths, all in the theme's
colors. This script recreates that look as a real icon theme for Dolphin and
the rest of Qt, and rewrites it from
~/.local/state/omarchy/current/theme/colors.toml so it follows every theme
switch.

Installed at ~/.local/share/icons/Folio (it inherits Papirus-espresso, so
everything it doesn't draw still comes from Papirus). Run by
~/.config/omarchy/hooks/theme-set.d/70-folio-folder-icons.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
THEME = f"{HOME}/.local/state/omarchy/current/theme"
COLORS = f"{THEME}/colors.toml"
ICONS = f"{HOME}/.local/share/icons/Folio"
PLACES = f"{ICONS}/scalable/places"
MIMETYPES = f"{ICONS}/scalable/mimetypes"
ACTIONS = f"{ICONS}/scalable/actions"
INHERITED = [
    f"{HOME}/.local/share/icons/Papirus-espresso/48x48/places",
    "/usr/share/icons/Papirus/48x48/places",
]
MIME_DIRS = [
    "/usr/share/icons/Papirus/48x48/mimetypes",
    "/usr/share/icons/Papirus/24x24/mimetypes",
    "/usr/share/icons/Papirus/16x16/mimetypes",
]
KDEGLOBALS = f"{HOME}/.config/kdeglobals"
QTENGINE = f"{HOME}/.config/qtengine/config.json"


# --- Folio's color math (src/theme.cpp) -----------------------------------

def _linear(v: float) -> float:
    return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4


def luminance(hex_color: str) -> float:
    r, g, b = (int(hex_color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return 0.2126 * _linear(r) + 0.7152 * _linear(g) + 0.0722 * _linear(b)


def ratio(a: str, b: str) -> float:
    x, y = luminance(a), luminance(b)
    return (max(x, y) + 0.05) / (min(x, y) + 0.05)


def mix(a: str, b: str, t: float) -> str:
    ca = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    cb = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x * (1 - t) + y * t):02x}" for x, y in zip(ca, cb))


def ensure_ratio(ink: str, ground: str, need: float) -> str:
    """The ink if it reads on the ground, else the least mix toward black/white."""
    if ratio(ink, ground) >= need:
        return ink
    toward = "#000000" if luminance(ground) > 0.179 else "#ffffff"
    low, high = 0.0, 1.0
    best = toward
    for _ in range(18):
        middle = (low + high) / 2
        candidate = mix(ink, toward, middle)
        if ratio(candidate, ground) >= need:
            best, high = candidate, middle
        else:
            low = middle
    return mix(ink, toward, high)


def read_colors(path: str) -> dict[str, str]:
    with open(path, encoding="utf-8") as f:
        text = f.read()
    return dict(re.findall(r'^\s*([a-z_]+)\s*=\s*["\'](#[0-9a-fA-F]{6})["\']', text, re.M))


# --- Folio's folder silhouette (src/FileTile.qml) --------------------------

def _num(value: float) -> str:
    return f"{value:.2f}".rstrip("0").rstrip(".")


def folder_path(radius: int) -> str:
    if radius <= 0:
        return "M4.5 88.5V0.5H46L50 6.5H123.5V88.5Z"
    r = radius
    t = min(r, 3)
    n = _num
    return (
        f"M4.5 {n(88.5 - r)}V{n(0.5 + r)}Q4.5 0.5 {n(4.5 + r)} 0.5"
        f"H{n(46 - t)}Q46 0.5 {n(46 + t * 0.6)} {n(0.5 + t * 0.9)}"
        f"L{n(50 - t * 0.6)} {n(6.5 - t * 0.9)}"
        f"Q50 6.5 {n(50 + t)} 6.5H{n(123.5 - r)}Q123.5 6.5 123.5 {n(6.5 + r)}"
        f"V{n(88.5 - r)}Q123.5 88.5 {n(123.5 - r)} 88.5H{n(4.5 + r)}"
        f"Q4.5 88.5 4.5 {n(88.5 - r)}Z"
    )


def hyprland_rounding() -> int:
    try:
        out = subprocess.run(
            ["hyprctl", "getoption", "decoration:rounding", "-j"],
            capture_output=True, text=True, timeout=2,
        ).stdout
        return int(json.loads(out).get("int", 0))
    except Exception:
        return 0


def write_if_changed(path: str, content: bytes) -> bool:
    try:
        with open(path, "rb") as f:
            if f.read() == content:
                return False
    except FileNotFoundError:
        pass
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(content)
    os.replace(tmp, path)
    return True


def write_svg(path: str, fill: str) -> bool:
    svg = (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<svg xmlns="http://www.w3.org/2000/svg" width="128" height="92" '
        'viewBox="0 0 128 92">\n'
        f'  <path d="{folder_path(hyprland_rounding())}" fill="{fill}"/>\n'
        '</svg>\n'
    )
    return write_if_changed(path, svg.encode())


# --- Folio's line icons (src/Glyph.qml) ------------------------------------

def _box(x: float, y: float, w: float, h: float, rad: float = 0) -> str:
    n = _num
    if rad <= 0:
        return f"M{n(x)} {n(y)}h{n(w)}v{n(h)}h{n(-w)}z"
    x2, y2 = x + w, y + h
    return (
        f"M{n(x + rad)} {n(y)}H{n(x2 - rad)}Q{n(x2)} {n(y)} {n(x2)} {n(y + rad)}"
        f"V{n(y2 - rad)}Q{n(x2)} {n(y2)} {n(x2 - rad)} {n(y2)}"
        f"H{n(x + rad)}Q{n(x)} {n(y2)} {n(x)} {n(y2 - rad)}"
        f"V{n(y + rad)}Q{n(x)} {n(y)} {n(x + rad)} {n(y)}Z"
    )


def _circle(cx: float, cy: float, r: float) -> str:
    n = _num
    return (
        f"M{n(cx - r)} {n(cy)}a{n(r)} {n(r)} 0 1 0 {n(2 * r)} 0"
        f"a{n(r)} {n(r)} 0 1 0 {n(-2 * r)} 0"
    )


# Only the names Dolphin's toolbar and common actions ask for; everything else
# keeps its Papirus icon. Each path lives on the same 24-unit grid, with the
# same 1.6 stroke, so the set reads as one hand.
