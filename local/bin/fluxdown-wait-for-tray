#!/usr/bin/env bash
# Wait for the Omarchy shell's StatusNotifierWatcher before FluxDown starts.
#
# FluxDown autostarts through systemd as soon as the graphical session is up,
# which can be several seconds before quickshell registers the tray host.
# If FluxDown looks for the tray too early it disables its tray icon for the
# whole session, and the autostart falls back to opening the main window.
#
# Wait up to 30 seconds for the watcher, then start FluxDown either way so a
# broken shell never keeps the app from starting.

for _ in $(seq 1 120); do
  if gdbus call --session \
      --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.NameHasOwner \
      org.kde.StatusNotifierWatcher 2>/dev/null | grep -q 'true'; then
    exit 0
  fi
  sleep 0.25
done

exit 0
