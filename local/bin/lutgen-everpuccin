#!/bin/bash
# lutgen-everpuccin —— grade wallpapers toward the everpuccin palette, with the
# SAME precision as lutgen's own built-in palettes (rose-pine, catppuccin, ...).
#
# Unlike the old version (which used Gaussian-RBF `-R -s 128` + a 60/40 blend,
# washing every hue), this uses lutgen's natural palette mapping:
#   lutgen apply -l 16 -p everpuccin <img>
#   ->  darks snap EXACTLY to #181B1B (black -> #181B1B byte-for-byte)
#   ->  vivid objects snap to their palette hue (red -> #E67E80, sun -> #E7C78B)
#   ->  surfaces grade through the theme neutrals (no desaturation wash)
#
# The palette is rebuilt from the live theme's colors.toml into
# ~/.config/lutgen/<theme>.txt every run, so it always tracks the theme.
#
# Usage:
#   lutgen-everpuccin <input.jpg|png|glob...> [--blend N] [--level N] [--flat] [-o DIR]
#
#   (default) -> exact lutgen palette mapping, LUT level 16
#   --blend N -> blend N% of the ORIGINAL back into the result (0 = none)
#   --level N -> Hald CLUT level (2-16). Default 16 = max precision.
#   --flat    -> hard nearest-neighbor snap (posterized, experimental)
#   -o DIR    -> output directory (default: same as each input)
#
# Output: <name>_<theme>.png next to each input (or in -o DIR).
#
# Examples:
#   lutgen-everpuccin ~/Downloads/wall.jpg
#   lutgen-everpuccin ~/Wallpapers/*.png
#   lutgen-everpuccin *.jpg --blend 20 -o ~/Wallpapers/everpuccin

set -u

# theme comes from the live Omarchy theme when possible, else everpuccin
THEME="${LUTGEN_THEME:-}"
if [ -z "$THEME" ] && [ -f "$HOME/.local/state/omarchy/current/theme.name" ]; then
  THEME="$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null | tr 'A-Z' 'a-z' | tr ' _' '--')"
fi
THEME="${THEME:-everpuccin}"

THEME_TOML="$HOME/.config/omarchy/themes/$THEME/colors.toml"
[ -f "$THEME_TOML" ] || THEME_TOML="$HOME/.config/omarchy/themes/everpuccin/colors.toml"
LUTGEN_DIR="${LUTGEN_DIR:-$HOME/.config/lutgen}"
mkdir -p "$LUTGEN_DIR"
PALFILE="$LUTGEN_DIR/$THEME.txt"

MODE="precise"
BLEND=0
LEVEL=16
OUTDIR=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --flat) MODE="flat" ;;
    --blend) BLEND="$2"; shift ;;
    --level) LEVEL="$2"; shift ;;
    -o) OUTDIR="$2"; shift ;;
    *) args+=("$1") ;;
  esac
  shift
done

[ ${#args[@]} -eq 0 ] && { echo "usage: $0 <image|glob>... [--blend N] [--level N] [--flat] [-o DIR]"; exit 1; }

# 1. build the lutgen palette file from the theme's colors.toml
python3 - "$THEME_TOML" "$PALFILE" <<'EOF'
import re, sys
toml, out = sys.argv[1], sys.argv[2]
vals = {}
try:
    for line in open(toml):
        m = re.match(r'\s*([A-Za-z0-9_]+)\s*=\s*"#([0-9A-Fa-f]{6})"', line)
        if m:
            vals[m.group(1).lower()] = m.group(2).lower()
except FileNotFoundError:
    pass
# curated base16-style slot order: neutral ramp dark->light, then accents, then brights
# (fallbacks = everpuccin values so anything without a key still grades correctly)
slots = [
    ("background",        "181b1b"),
    ("color0",            "232a2e"),
    ("selection",         "2d353b"),
    ("color8",            "56635f"),
    ("muted",             "7a8478"),
    ("dark_foreground",   "859289"),
    ("brown",             "a19983"),
    ("foreground",        "e7decd"),
    ("light_foreground",  "f1e4c2"),
    ("bright_foreground", "faf4ed"),
    ("green",             "a7c080"),   # accent / sage
    ("cyan",              "83c092"),
    ("blue",              "7fbbb3"),
    ("yellow",            "dbbc7f"),
    ("orange",            "e69875"),
    ("red",               "e67e80"),
    ("magenta",           "d699b6"),
    ("bright_red",        "f18f91"),
    ("bright_green",      "b7d090"),
    ("bright_yellow",     "e7c78b"),
    ("bright_blue",       "8fcac2"),
    ("bright_magenta",    "e3a8c3"),
    ("bright_cyan",       "98d1a6"),
]
colors = []
for key, fallback in slots:
    colors.append("#" + (vals.get(key) or fallback))
open(out, "w").writelines(c + "\n" for c in colors)
EOF

for src in "${args[@]}"; do
  [ -f "$src" ] || continue
  dir="$OUTDIR"
  [ -n "$dir" ] || dir="$(dirname "$src")"
  base="$(basename "$src")"; base="${base%.*}"
  out="$dir/${base}_${THEME}.png"

  case "$MODE" in
    flat)
      lutgen apply -N -l "$LEVEL" -p "$THEME" -o "$out" "$src" >/dev/null 2>&1
      ;;
    precise)
      lutgen apply -l "$LEVEL" -p "$THEME" -o "$out" "$src" >/dev/null 2>&1
      if [ "$BLEND" -gt 0 ]; then
        tmp="$out.blend.png"
        mv "$out" "$tmp"
        python3 - "$src" "$tmp" "$out" "$BLEND" <<'PYEOF'
import sys
from PIL import Image
o = Image.open(sys.argv[1]).convert("RGB")
l = Image.open(sys.argv[2]).convert("RGB")
o = o.resize(l.size)
Image.blend(o, l, float(sys.argv[4]) / 100.0).save(sys.argv[3])
PYEOF
        rm -f "$tmp"
      fi
      ;;
  esac
  echo "OK  $src -> $out  [l${LEVEL} $MODE blend=${BLEND}% pal=$THEME]"
done