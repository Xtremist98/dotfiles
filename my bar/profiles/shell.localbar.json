{
  "bar": {
    "edgeLine": false,
    "transparent": false,
    "barMode": 2,
    "box": {
      "groups": [
        [
          "omarchy.menu",
          "omarchy.workspaces"
        ],
        [
          "local.cpu",
          "dim-separator",
          "local.memory"
        ],
        [
          "netspeed",
          "omarchy.network"
        ],
        [
          "omarchy.bluetooth",
          "omarchy.audio",
          "omarchy.monitor",
          "omarchy.power"
        ],
        [
          "wian47.removable-drives",
          "io.github.birajdotdev.omacore",
          "local.dropbox"
        ]
      ],
      "innerPadding": 6,
      "innerSpacing": 0,
      "moduleSpacing": 6,
      "outerMargin": 4,
      "color": "#cc26233a",
      "borderColor": "#19ebbcba",
      "unboxed": [
        "omarchy.spacer",
        "omarchy.tray"
      ]
    },
    "centerAnchor": "omarchy.clock",
    "id": "local.bar",
    "layout": {
      "center": [
        {
          "color": "color35",
          "id": "omarchy.indicators",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Indicators.qml",
          "type": "qml"
        },
        {
          "birthYear": 1991,
          "color": "color12",
          "format": "dddd hh:mm A",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "source": "~/.config/omarchy/plugins/local.clock/BarWidget.qml",
          "type": "qml",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "color": "color10",
          "id": "omarchy.system-update",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/SystemUpdate.qml",
          "type": "qml"
        },
        {
          "color": "color19",
          "id": "omarchy.weather",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Weather.qml",
          "type": "qml",
          "unit": "metric"
        }
      ],
      "left": [
        {
          "color": "color34",
          "id": "omarchy.menu"
        },
        {
          "color": "color16",
          "id": "omarchy.workspaces",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Workspaces.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "color": "color23",
          "id": "mpris",
          "source": "~/.config/omarchy/plugins/local.bar/panels/media/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "color": "color10",
          "id": "window-info",
          "source": "~/.config/omarchy/plugins/local.bar/panels/window/Panel.qml",
          "type": "qml"
        }
      ],
      "right": [
        {
          "color": "color20",
          "forceColorize": [
            "Free Download",
            "stremio-service",
            "Windscribe",
            "localsend",
            "qbittorrent",
            "discord",
            "vesktop",
            "chatgpt"
          ],
          "id": "omarchy.tray",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Tray.qml",
          "type": "qml"
        },
        {
          "color": "color15",
          "id": "wian47.removable-drives"
        },
        {
          "color": "color27",
          "id": "io.github.birajdotdev.omacore",
          "macAddress": "34:09:C9:96:82:0C"
        },
        {
          "color": "color22",
          "id": "local.dropbox"
        },
        {
          "color": "color17",
          "id": "stappmus.activity-monitor"
        },
        {
          "color": "color10",
          "id": "local.cpu"
        },
        {
          "id": "dim-separator",
          "type": "qml"
        },
        {
          "color": "color30",
          "id": "local.memory"
        },
        {
          "color": "color13",
          "id": "netspeed",
          "type": "qml"
        },
        {
          "color": "color28",
          "id": "omarchy.network",
          "source": "~/.config/omarchy/plugins/local.bar/panels/network/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color14",
          "id": "omarchy.bluetooth",
          "source": "~/.config/omarchy/plugins/local.bar/panels/bluetooth/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color18",
          "id": "omarchy.audio",
          "source": "~/.config/omarchy/plugins/local.bar/panels/audio/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color36",
          "id": "omarchy.monitor",
          "source": "~/.config/omarchy/plugins/local.bar/panels/monitor/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color10",
          "id": "omarchy.power",
          "source": "~/.config/omarchy/plugins/local.bar/panels/power/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color11",
          "id": "omarchy.system",
          "source": "~/.config/omarchy/plugins/local.bar/panels/system/Panel.qml",
          "type": "qml"
        }
      ]
    },
    "position": "top"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.oldjobobo.thpm"
    },
    {
      "id": "mirador"
    }
  ],
  "version": 1
}
