# Maintainer: linuxer
pkgname=rose-pine-dark-gtk-theme
pkgver=1.0
pkgrel=1
pkgdesc="Rose Pine Dark GTK3/GTK4 theme matching the Omarchy rose-pine-dark palette"
arch=('any')
license=('GPL3')
url="https://github.com/linuxer/rose-pine-dark-gtk-theme"

package() {
  install -dm755 "$pkgdir/usr/share/themes/rose-pine-dark"
  cp -r "$startdir/rose-pine-dark/." "$pkgdir/usr/share/themes/rose-pine-dark/"
}
