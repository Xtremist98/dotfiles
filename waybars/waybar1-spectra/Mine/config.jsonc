{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 20,
  //"margin-left": 0,
  //"margin-right": 0,
  "modules-left": [
    "custom/omarchy",
    "clock",
    "custom/weather",
    "mpris",
    "hyprland/window"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "idle_inhibitor",
    "custom/update", 
    "custom/screenrecording-indicator"
  ],
  "modules-right": [
    "network",
    "tray",
    "bluetooth",
    "cpu",
    "backlight",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
    "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },
  "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 35,
    "rewrite": {
      " - ": "", // if no window is focused, a single dash is displayed, this removes it
      "(.*?) - Chromium - chromium": "  $1",
      "(.*?) - Helium - helium": "  $1",
      "(.*) - Obsidian - .* - obsidian": "  $1",
      "(.*nvim)...(.*)": "  $2",
      "(.*code) - (.*)": "󰨞  $1",
      "^.*btop( .*|$)": "󰧨 BTOP $1",
      "^.*cmatrix( .*|$)": "󰘨 MATRIX $1",
      "(.*) - org.omarchy.bluetui": " Bluetooth",
      "(.*) - com.omarchy.impala": "  Impala",
      "(.*) - Spotify": "  $1",
      "(.*) - mpv": "  $1",
      "(.*) - xed": " $1",
      "(.*) - jamesdsp": "󰺢 $1",
      "(.*) - free download manager": "  Download Manager",
      "(.*) - org.kde.ark": " $1",
      "(.*) - org.qbittorrent.qBittorrent": " QBittorrent",
      "(.*) - org.telegram.desktop": "  $1",
      "(.*) - com.mitchellh.ghostty": "󰊠  Terminal",
      "(.*) - Alacritty": "  Alacritty",
      "(.*) - org.omarchy.wiremix": "󰓃 Wiremix",
      "(.*) - BeeperTexts": "󰻞  $1",
      "(.*) - protonvpn-app": "󰖂  Proton",
      "(.*) - org.omarchy.terminal": "<span font='omarchy'>\ue900</span> Omarchy",
      "(.*) - org.omarchy.bash": "  System-Info",
      "(.*Discord)...(.*).. (.*)": "  $2",
      "(.*) - org.gnome.Nautilus": "󰣆  $1",
      "(.*) - org.kde.dolphin": "  dolphin",
      // "OBS *. - (.*) - com.obsproject.Studio": "  $1", // not yet functional
      // "nvim (.*) - com.mitchellh.ghostty": "  $1", // not being captured
    }
  },
  "custom/omarchy": {
    "format": "",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space"
  },
  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 3600
  },
    "cpu": {
    "interval": 1,
    "format": "",
    "on-click": "$TERMINAL -e btop"
  },
    "clock": {
    "format": "  {:%I:%M %p}",
    "format-alt": "  {:L%d %B %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "mouth",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "mouth": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
    "on-click-right": "~/.local/share/omarchy/bin/omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
  },
 
  "battery": {
    "format": "{icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 3,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "{device_alias} • {device_address}",
    "on-click": "omarchy-launch-bluetooth"
  },
   "pulseaudio": {
    "format": "{icon}",
    "on-click": "omarchy-launch-or-focus-tui wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 1,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "hands-free": "󰋋",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  },
   "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "⇣ {bandwidthDownBytes} {icon}",
    "format-ethernet": "⇣ {bandwidthDownBytes} 󰀂 ",
    "format-disconnected": "󰤭",
    "format-disabled": "",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "IP: {ipaddr} | CIDR: {cidr} | Interface: {ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 1,
    "spacing": 1,
    "on-click": "nm-connection-editor"
  },
    "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "󰐊",
      "mpv": "󰐊"
    },
     "status-icons": {
      "paused": "⏸"
    },
    "max-length": 10
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 10,
    "spacing": 12
  },
   "backlight": {
      "device": "intel_backlight",
      "format": "{icon}",
      "format-icons": ["", "󰖨"],
      "tooltip-format": "{percent}%"
  },
  "custom/power": {
    "format": " ",
    "on-click": "omarchy-menu system",
    "tooltip-format": "Power Menu"
  },
  "custom/weather": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 300,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/weather.sh"
  },
   "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
        "activated": "",
        "deactivated": "",
    "on-click": "omarchy-toggle-idle"
    }
  }
}
