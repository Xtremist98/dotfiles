{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 25,

  // "margin-top": 10,
  // "margin-left": 200,
  // "margin-right": 200,

  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": ["custom/omarchy", "clock", "custom/weather", "mpris", "hyprland/window"],
  "modules-center": [
    "hyprland/workspaces",
    "custom/update", 
    "custom/screenrecording-indicator",
    "custom/voxtype"
  ],
  "modules-right": [
    "tray",
    "cpu",
    // "memory",
    "backlight",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery"
  ],
   "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
    "active": " "
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
      // "6": []
      // "7": [],
      // "8": []   
    }
  },

  "custom/power": {
    "format": "",
    "on-click": "omarchy-menu system",
    "tooltip-format": "Power Menu"
  },

  "custom/omarchy": {
    // "format": "<span font='omarchy'>\ue900</span>",
    "format": "ARCH",
    "on-click": "omarchy-menu",
    "on-click-right": "omarchy-cmd-screenrecord --with-desktop-audio",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space"
  },
  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 3600
  },

  "cpu": {
    "interval": 5,
    "format": "󰍛 {usage}%",
    "on-click": "omarchy-launch-tui btop",
    "on-click-right": "omarchy-toggle-idle"
  },
   "clock": {
    "format": "  {:%I:%M %p}",
    "format-alt": "  {:L%d %B %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "mouth",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "mouth": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
    "on-click-right": "~/.local/share/omarchy/bin/omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "⇣ {bandwidthDownBytes} {icon}",
    "format-ethernet": "⇣ {bandwidthDownBytes} 󰀂 ",
    "format-disconnected": "󰤭",
    "format-disabled": "",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "IP: {ipaddr} | CIDR: {cidr} | Interface: {ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 1,
    "spacing": 1,
    "on-click": "omarchy-launch-tui gazelle"
  },

  "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "Full ",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false,
        "on-click": "omarchy-menu system"
    },
    "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format": "{device_alias} • {device_address}",
    "on-click": "omarchy-launch-bluetooth"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " 󰖁 0% ",
    "format-icons": {
      "headphone": "",
      "hands-free": "  ",
      "headset": "  ",
      "phone": "  ",
      "portable": "  ",
      "car": "  ",
      "headphone": "",
      "default": [
        "  ",
        "  ",
        "  "
      ]
    },
    "on-click": "/usr/bin/pavucontrol",
    "on-click-right": "pactl -- set-sink-mute 0 toggle",
    "tooltip": true,
    "tooltip-format": "Playing at: {volume}%"
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray", "memory"]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "󰍬",
      "transcribing": "󰔟"
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12
  },
  
  //EXTRA MODULES!
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}% ",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
    "format-icons": ["", "󰖨"],
    "on-click-right": "omarchy-toggle-nightlight"
  },

  "memory": {
      "format": "  {percentage}%",
      "interval": 2,
      "on-click": "$TERMINAL -e btop"
  },
  
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 60,
    "exec": "wttrbar --nerd --location Shabqadar",
    "on-click": "~/.config/waybar/scripts/weather-tooltip.sh",
    "return-type": "json"
  },
  "mpris": {
    "format": "{player_icon} {position}",
    "format-paused": "{status_icon} {position}",
    "interval": 1,
    "player-icons": {
      "default": "󰐊",
      "mpv": "󰐊"
    },
     "status-icons": {
      "paused": "⏸"
    },
    "max-length": 13
  },
  "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 35,
    "rewrite": {
      " - ": "", // if no window is focused, a single dash is displayed, this removes it
      "(.*?) - Chromium - chromium": " $1",
      "(.*?) - Helium - helium": " $1",
      "(.*) - Obsidian - .* - obsidian": " $1",
      "(.*nvim)...(.*)": " $2",
      "(.*code) - (.*)": "󰨞  $1",
      "^.*btop( .*|$)": "󰧨 Btop",
      "^.*youtube( .*|$)": " YouTube",
      "^.*cmatrix( .*|$)": "󰘨 MATRIX $1",
      "(.*) - org.omarchy.bluetui": " Bluetooth",
      "(.*) - com.omarchy.impala": "  Impala",
      "(.*) - org.omarchy.gazelle": "󰀂 Network",
      "(.*) - Spotify": "  $1",
      "(.*) - mpv": " $1",
      "(.*) - xed": " $1",
      "(.*) - jamesdsp": "󰺢 $1",
      "(.*) - fdm": " Downloader",
      "(.*) - org.kde.ark": " $1",
      "(.*) - org.qbittorrent.qBittorrent": " Torrent",
      "(.*) - com.ayugram.desktop": " $1",
      "(.*) - com.mitchellh.ghostty": "󰊠 Ghostty",
      "(.*) - kitty": "󰊠 Kitty",
      "(.*) - Alacritty": " Alacritty",
      "(.*) - org.omarchy.wiremix": "󰓃 Wiremix",
      "(.*) - BeeperTexts": "󰻞  $1",
      "(.*) - protonvpn-app": "󰖂 Proton",
      "(.*) - org.omarchy.terminal": "<span font='omarchy 8'>\ue900</span> Omarchy",
      "(.*) - org.omarchy.bash": " System-Info",
      "(.*Discord)...(.*).. (.*)": " $2",
      "(.*) - org.gnome.Nautilus": "󰣆 $1",
      "(.*) - org.kde.dolphin": " Explorer",
      "(.*) - org.omarchy.rmpc": " Music",
      "(.*) - org.omarchy.kew": " Music",
      "(.*) - org.omarchy.spf": " Files",
      "(.*) - Windscribe": " Windscribe",
      "(.*) - org.omarchy.nvtop": " Gpu",
      "(.*) - org.pulseaudio.pavucontrol": " Audio-set",
      // "OBS *. - (.*) - com.obsproject.Studio": "  $1", // not yet functional
      // "nvim (.*) - com.mitchellh.ghostty": "  $1", // not being captured
    }
  }
}
