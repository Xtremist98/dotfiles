{
  "bar": {
    "box": {
      "groups": [
        [
          "omarchy.menu",
          "omarchy.workspaces"
        ],
        [
          "local.cpu",
          "local.memory"
        ],
        [
          "netspeed",
          "omarchy.network"
        ],
        [
          "omarchy.bluetooth",
          "omarchy.audio",
          "omarchy.monitor",
          "omarchy.power"
        ],
        [
          "omarchy.tray",
          "omarchy.dropbox",
          "local.model-usage"
        ]
      ],
      "innerPadding": 4,
      "innerSpacing": 0,
      "moduleSpacing": 6,
      "outerMargin": 4,
      "unboxed": [
        "omarchy.spacer"
      ]
    },
    "centerAnchor": "omarchy.clock",
    "id": "local.bar",
    "layout": {
      "center": [
        {
          "color": "color04",
          "id": "omarchy.indicators",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Indicators.qml",
          "type": "qml"
        },
        {
          "birthYear": 1991,
          "color": "color04",
          "format": "dddd hh:mm A",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "source": "~/.config/omarchy/plugins/local.clock/BarWidget.qml",
          "type": "qml",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "color": "color04",
          "id": "omarchy.system-update",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/SystemUpdate.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.weather",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Weather.qml",
          "type": "qml",
          "unit": "metric"
        }
      ],
      "left": [
        {
          "color": "color04",
          "id": "omarchy.menu"
        },
        {
          "color": "color04",
          "id": "omarchy.workspaces",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Workspaces.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "color": "color04",
          "id": "mpris",
          "source": "~/.config/omarchy/plugins/local.bar/panels/media/Panel.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 0
        },
        {
          "color": "color04",
          "id": "window-info",
          "source": "~/.config/omarchy/plugins/local.bar/panels/window/Panel.qml",
          "type": "qml"
        }
      ],
      "right": [
        {
          "color": "color04",
          "forceColorize": [
            "Free Download",
            "stremio-service",
            "Windscribe"
          ],
          "id": "omarchy.tray",
          "source": "~/.config/omarchy/plugins/local.bar/widgets/Tray.qml",
          "type": "qml"
        },
        {
          "id": "dev.deoxizn.devicebattstats"
        },
        {
          "color": "color04",
          "id": "omarchy.dropbox",
          "source": "~/.config/omarchy/plugins/local.dropbox/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "local.model-usage"
        },
        {
          "color": "color04",
          "id": "local.cpu"
        },
        {
          "color": "color04",
          "id": "local.memory"
        },
        {
          "color": "color04",
          "id": "netspeed",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.network",
          "source": "~/.config/omarchy/plugins/local.bar/panels/network/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.bluetooth",
          "source": "~/.config/omarchy/plugins/local.bar/panels/bluetooth/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.audio",
          "source": "~/.config/omarchy/plugins/local.bar/panels/audio/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.monitor",
          "source": "~/.config/omarchy/plugins/local.bar/panels/monitor/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.power",
          "source": "~/.config/omarchy/plugins/local.bar/panels/power/Panel.qml",
          "type": "qml"
        },
        {
          "color": "color04",
          "id": "omarchy.system",
          "source": "~/.config/omarchy/plugins/local.bar/panels/system/Panel.qml",
          "type": "qml"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.oldjobobo.thpm"
    }
  ],
  "version": 1
}
